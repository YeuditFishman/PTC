FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies (SSL certs)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install dependencies + dev tools
RUN python -m pip install --upgrade pip --trusted-host pypi.org --trusted-host files.pythonhosted.org \
    && pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org \
       -r requirements.txt \
       flake8 ruff pytest pytest-mock

# Copy app code
COPY app ./app

# Set PYTHONPATH for CI/test environment
ENV PYTHONPATH=/app

# Default command to run the FastAPI app
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
